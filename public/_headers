# 1-year immutable caching for Vite compiled hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 1-year immutable caching for web fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 7-day stale-while-revalidate for static images
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML document shell must never be cached
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# LLMs.txt for Agentic Browsing
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400
/.well-known/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400

# Crawlers and Sitemaps
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400


