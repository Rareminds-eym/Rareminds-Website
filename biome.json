{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/build",
			"!**/node_modules",
			"!**/supabase",
			"!**/*.svg"
		]
	},
	"formatter": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"enabled": false
		}
	},
	"css": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "off"
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
